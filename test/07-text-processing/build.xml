<?xml version="1.0" encoding="UTF-8"?>
<project name="text-processing-test" default="test" basedir=".">
    
    <description>
        Tests text processing: replace, replaceregexp, loadfile, concat
    </description>
    
    <property name="src.dir" value="${basedir}/src"/>
    <property name="build.dir" value="${basedir}/build"/>
    
    <target name="init">
        <mkdir dir="${src.dir}"/>
        <mkdir dir="${build.dir}"/>
        
        <!-- Create test files -->
        <echo file="${src.dir}/template.txt">Hello @NAME@!
Welcome to @PROJECT@.
Your version is @VERSION@.
Today is @DATE@.</echo>
        
        <echo file="${src.dir}/config.properties">
# Configuration file
server.host=localhost
server.port=8080
app.name=MyApp
app.debug=true
</echo>
        
        <echo file="${src.dir}/numbers.txt">Line 1: foo123bar
Line 2: abc456def
Line 3: test789end</echo>
    </target>
    
    <target name="test-replace" depends="init">
        <echo message="Testing replace..."/>
        
        <!-- Copy and replace tokens -->
        <copy file="${src.dir}/template.txt" tofile="${build.dir}/output.txt"/>
        <replace file="${build.dir}/output.txt" token="@NAME@" value="World"/>
        <replace file="${build.dir}/output.txt" token="@PROJECT@" value="Gantt"/>
        <replace file="${build.dir}/output.txt" token="@VERSION@" value="1.0"/>
        <replace file="${build.dir}/output.txt" token="@DATE@" value="2026-01-02"/>
        
        <loadfile property="replaced.content" srcFile="${build.dir}/output.txt"/>
        <echo message="Replaced content:"/>
        <echo message="${replaced.content}"/>
    </target>
    
    <target name="test-replaceregexp" depends="test-replace">
        <echo message="Testing replaceregexp..."/>
        
        <!-- Copy and replace with regex -->
        <copy file="${src.dir}/numbers.txt" tofile="${build.dir}/numbers-replaced.txt"/>
        <replaceregexp file="${build.dir}/numbers-replaced.txt" 
                       match="[0-9]+" 
                       replace="###" 
                       flags="g"/>
        
        <loadfile property="regex.content" srcFile="${build.dir}/numbers-replaced.txt"/>
        <echo message="Regex replaced:"/>
        <echo message="${regex.content}"/>
    </target>
    
    <target name="test-concat-files" depends="test-replaceregexp">
        <echo message="Testing concat..."/>
        
        <!-- Concatenate multiple files -->
        <concat destfile="${build.dir}/combined.txt">
            <fileset dir="${src.dir}" includes="*.txt"/>
        </concat>
        
        <length file="${build.dir}/combined.txt" property="combined.length"/>
        <echo message="Combined file length: ${combined.length} bytes"/>
    </target>
    
    <target name="test-concat-header-footer" depends="test-concat-files">
        <echo message="Testing concat with header/footer..."/>
        
        <!-- Concat with header and footer -->
        <concat destfile="${build.dir}/wrapped.txt"
                header="=== BEGIN ===${line.separator}"
                footer="${line.separator}=== END ===">
            <fileset dir="${src.dir}" includes="template.txt"/>
        </concat>
        
        <loadfile property="wrapped.content" srcFile="${build.dir}/wrapped.txt"/>
        <echo message="Wrapped content:"/>
        <echo message="${wrapped.content}"/>
    </target>
    
    <target name="test-loadproperties" depends="test-concat-header-footer">
        <echo message="Testing loadproperties..."/>
        
        <!-- Load properties from file -->
        <property file="${src.dir}/config.properties" prefix="cfg"/>
        <echo message="Loaded: cfg.server.host = ${cfg.server.host}"/>
        <echo message="Loaded: cfg.app.name = ${cfg.app.name}"/>
    </target>
    
    <target name="test" depends="init, test-replace, test-replaceregexp, 
                                  test-concat-files, test-concat-header-footer,
                                  test-loadproperties">
        <echo message=""/>
        <echo message="=== Text Processing Tests Complete ==="/>
    </target>
    
    <target name="clean">
        <delete dir="${src.dir}"/>
        <delete dir="${build.dir}"/>
    </target>
    
</project>

