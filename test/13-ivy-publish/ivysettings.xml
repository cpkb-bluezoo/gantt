<ivysettings>
  <resolvers>
    <filesystem name="publishrepo" m2compatible="false" root="${basedir}/publish-target">
      <artifact pattern="[organisation]/[module]/[revision]/[artifact]-[revision].[ext]"/>
      <ivy pattern="[organisation]/[module]/[revision]/ivy-[revision].xml"/>
    </filesystem>
  </resolvers>
  <settings defaultResolver="publishrepo"/>
</ivysettings>
