/gantt
*.o
*.dSYM
.DS_Store
*~

# Native fileops binaries compiled from src/fileops.c (see Makefile.am)
/gantt_copy
/gantt_delete
/gantt_move
/gantt_touch
/gantt_chmod
/gantt_mkdir
/gantt_concat

# Autotools: generated by ./autogen.sh, configure and make
/Makefile
/Makefile.in
/configure
/aclocal.m4
/autom4te.cache/
/build-aux/
/m4/
/INSTALL
/config.log
/config.status
/stamp-h1
.deps/
.dirstamp
/gantt-*.tar.*
/test-work/

# Generated test output - test/run-tests.sh regenerates these on every run
test/*/build/
test/*/dist/
test/*/publish-target/
# Stray output from unexpanded ${basedir} references (a pre-existing bug in
# some test build.xml files) landing as a literal directory name
test/*/${basedir}/
