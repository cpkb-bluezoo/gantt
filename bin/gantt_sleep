#!/bin/sh
# Copyright (C) 2005, 2026 Chris Burdess <dog@gnu.org>
# SPDX-License-Identifier: GPL-3.0-or-later
# gantt_sleep - Pause execution
#
# Environment variables:
#   seconds      - Number of seconds to sleep
#   milliseconds - Number of milliseconds to sleep
#   minutes      - Number of minutes to sleep
#   hours        - Number of hours to sleep

seconds="${seconds:-0}"
milliseconds="${milliseconds:-0}"
minutes="${minutes:-0}"
hours="${hours:-0}"

# Calculate total sleep time in seconds
total=$(echo "$seconds + $milliseconds / 1000 + $minutes * 60 + $hours * 3600" | bc -l 2>/dev/null || echo "$seconds")

if [ -n "$total" ] && [ "$total" != "0" ]; then
    sleep "$total"
fi

exit 0

